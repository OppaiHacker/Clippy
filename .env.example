# Copy to .env and adjust. Use absolute paths: docker compose does not expand ~.

# Where gpu-screen-recorder drops clips. Clippy never modifies them; it only deletes
# a clip when you empty the trash or delete it permanently.
CLIPS_DIR=/home/you/Videos/clips

# Clippy's own data: thumbnails, waveforms, demuxed audio, imports, exports
WORK_DIR=/home/you/.local/share/clippy

# Recorder control script behind the sidebar widget (see scripts/gsr-replay).
# Optional for a source install; required by docker compose.
GSR_SCRIPT=/home/you/.local/bin/gsr-replay

# Database, for a source install (defaults match docker-compose.yml).
# docker compose sets its own URLs for the app container and ignores these.
DATABASE_URL=postgresql+asyncpg://clippy:clippy@localhost:5434/clippy
SYNC_DATABASE_URL=postgresql+psycopg2://clippy:clippy@localhost:5434/clippy
